<section class="tab main-tab {{tabs.main.cssClass}}" data-group="primary" data-tab="main">
  {{#if creation}}{{> "systems/dtd40k/templates/actor/parts/creation.hbs"}}{{/if}}

  <section class="characteristics">
    <h2 class="section-title">{{localize "DTD.Sheet.Characteristics"}}</h2>
    <div class="cog-modules">
      {{#each gridRows as |row|}}
      {{#each row.cells as |entry|}}
      <div class="trait characteristic cog-module" data-key="{{entry.key}}">
        <span class="cog-axis">{{localize row.label}} · {{localize (lookup (lookup @root.gridColumns @index) "label")}}</span>
        <div class="cog-module-name">
          {{#if @root.isEdit}}
          <span class="trait-name" data-tooltip="{{localize entry.abbr}}">{{localize entry.label}}</span>
          {{else}}
          <a class="trait-name roll-link" data-action="rollCharacteristic" data-key="{{entry.key}}" data-tooltip="{{localize "DTD.Roll.RollTooltip"}} · {{entry.pool}}">{{localize entry.label}}</a>
          {{/if}}
        </div>
        <b class="cog-module-value">{{entry.value}}</b>
        <div class="trait-row">
          {{> "systems/dtd40k/templates/actor/parts/dots.hbs" dots=entry.dots path=entry.valuePath capped=entry.capped editable=@root.isEdit}}
          {{> "systems/dtd40k/templates/actor/parts/advance-button.hbs" advance=entry.advance action="advanceCharacteristic" key=entry.key}}
        </div>
        {{> "systems/dtd40k/templates/actor/parts/specialties.hbs" entry=entry isEdit=@root.isEdit}}
      </div>
      {{/each}}
      {{/each}}
    </div>
  </section>

  <section class="skills">
    <div class="skills-header">
      <h2 class="section-title">{{localize "DTD.Sheet.Skills"}}</h2>
      {{#unless isEdit}}
      <div class="skill-filters">
        <input class="skill-search" type="search" placeholder="{{localize "DTD.Sheet.SearchSkills"}}" aria-label="{{localize "DTD.Sheet.SearchSkills"}}">
        <label class="only-trained"><input class="skill-only-trained" type="checkbox"> {{localize "DTD.Sheet.OnlyTrained"}}</label>
      </div>
      {{/unless}}
    </div>
    <div class="cog-skill-groups">
      {{#each skillColumns as |column|}}
      <div class="skill-column cog-skill-group" data-group="{{column.key}}">
        <h3>{{localize column.label}}</h3>
        <ol class="trait-list">
          {{#each column.entries as |entry|}}
          <li class="trait skill{{#if entry.advanced}} advanced{{/if}}{{#unless entry.value}} untrained-row{{/unless}}" data-key="{{entry.key}}" data-skill-name="{{entry.name}}" data-value="{{entry.value}}">
            <div class="trait-row">
              {{#if (or @root.isEdit entry.blocked)}}
              <span class="trait-name{{#if entry.blocked}} blocked{{/if}}">
                {{entry.name}}{{#if entry.advanced}}<span class="advanced-mark" data-tooltip="{{localize "DTD.Sheet.Advanced"}}">*</span>{{/if}}
                <span class="trait-char">{{localize entry.charAbbr}}</span>
              </span>
              {{else}}
              <a class="trait-name roll-link" data-action="rollSkill" data-key="{{entry.key}}" data-tooltip="{{localize "DTD.Roll.RollTooltip"}}">
                {{entry.name}}{{#if entry.advanced}}<span class="advanced-mark">*</span>{{/if}}
                <span class="trait-char">{{localize entry.charAbbr}}</span>
              </a>
              {{/if}}
              {{> "systems/dtd40k/templates/actor/parts/dots.hbs" dots=entry.dots path=entry.valuePath capped=entry.capped editable=@root.isEdit}}
              {{#unless @root.isEdit}}
              {{#if entry.blocked}}
              <span class="cog-roll none" data-tooltip="{{localize "DTD.Roll.AdvancedUntrained"}}"><i class="fa-solid fa-lock" inert></i></span>
              {{else}}
              <a class="cog-roll{{#if entry.untrained}} untrained{{/if}}" data-action="rollSkill" data-key="{{entry.key}}" data-tooltip="{{#if entry.untrained}}{{localize "DTD.Roll.Untrained"}}{{else}}{{localize "DTD.Roll.RollTooltip"}}{{/if}}">{{entry.pool}} <i class="fa-solid fa-caret-right" inert></i></a>
              {{/if}}
              {{/unless}}
              {{> "systems/dtd40k/templates/actor/parts/advance-button.hbs" advance=entry.advance action="advanceSkill" key=entry.key}}
            </div>
            {{> "systems/dtd40k/templates/actor/parts/specialties.hbs" entry=entry isEdit=@root.isEdit}}
          </li>
          {{/each}}
        </ol>
      </div>
      {{/each}}
    </div>
  </section>
</section>
