<section class="characteristics">
  <h2 class="section-title">{{localize "DTD.Sheet.Characteristics"}}</h2>
  <div class="char-grid">
    <span class="grid-corner"></span>
    {{#each gridColumns as |column|}}
    <span class="grid-column-label">{{localize column.label}}</span>
    {{/each}}
    {{#each gridRows as |row|}}
    <span class="grid-row-label">{{localize row.label}}</span>
    {{#each row.cells as |entry|}}
    <div class="trait characteristic" data-key="{{entry.key}}">
      <div class="trait-row">
        {{#if ../../isEdit}}
        <span class="trait-name" data-tooltip="{{localize entry.abbr}}">{{localize entry.label}}</span>
        {{else}}
        <a class="trait-name roll-link" data-action="rollCharacteristic" data-key="{{entry.key}}" data-tooltip="{{localize "DTD.Roll.RollTooltip"}}">
          <i class="fa-solid fa-dice-d10" aria-hidden="true"></i> {{localize entry.label}}
        </a>
        {{/if}}
        {{> "systems/dtd40k/templates/actor/parts/dots.hbs" dots=entry.dots path=entry.valuePath editable=../../isEdit}}
        {{#unless ../../isEdit}}<span class="pool">{{entry.pool}}</span>{{/unless}}
      </div>
      {{> "systems/dtd40k/templates/actor/parts/specialties.hbs" entry=entry isEdit=../../isEdit}}
    </div>
    {{/each}}
    {{/each}}
  </div>
</section>
