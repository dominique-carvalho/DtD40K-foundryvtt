<div class="xp-dialog">
  <div class="form-group">
    <label><input type="radio" name="kind" value="encounter" checked> {{localize "DTD.Xp.ByEncounter"}}</label>
    <select name="difficulty">
      {{#each difficulties as |d|}}<option value="{{d.key}}" {{#if (eq d.key "ordinary")}}selected{{/if}}>{{d.label}} ({{d.xp}})</option>{{/each}}
    </select>
  </div>
  <div class="form-group">
    <label><input type="radio" name="kind" value="session"> {{localize "DTD.Xp.BySession"}}</label>
  </div>
  <div class="form-group">
    <label>{{localize "DTD.Xp.BonusLabel"}}</label>
    <input type="number" name="bonus" value="0" step="10">
    <input type="text" name="reason" placeholder="{{localize "DTD.Xp.ReasonPlaceholder"}}">
  </div>
  <fieldset>
    <legend>{{localize "DTD.Xp.Characters"}}</legend>
    {{#each characters as |c|}}<label class="xp-character"><input type="checkbox" name="char-{{c.id}}" {{checked c.checked}}> {{c.name}}</label>{{/each}}
  </fieldset>
</div>
