<div class="dtd40k attack-card-extra">
  <p class="roll-card-note">{{#if proficient}}{{localize "DTD.Attack.Proficient"}}{{else}}{{localize "DTD.Attack.NotProficient"}}{{/if}}{{#each notes as |note|}} · {{note}}{{/each}}</p>
  {{#if requiredRaises}}<p class="roll-card-note">{{localize "DTD.Attack.RequiredRaises" raises=requiredRaises}}</p>{{/if}}
  <p class="attack-location"><i class="fa-solid fa-location-crosshairs" inert></i> {{localize "DTD.Attack.Location"}}: <b>{{location}}</b> <span class="hint">{{#if called}}({{localize "DTD.Attack.Called"}}){{else}}(d10 {{d10}}){{/if}}</span></p>
  {{#if hits}}<p class="attack-hits">{{localize "DTD.Attack.Hits" hits=hits}}</p>{{/if}}
  {{#if jammed}}<p class="notification warning">{{localize "DTD.Attack.Jammed"}}{{#if overheats}} {{localize "DTD.Attack.Overheats"}}{{/if}}</p>{{/if}}
  {{#if textQualities.length}}
  <p class="quality-tags">{{#each textQualities as |q|}}<span class="tag" data-tooltip="{{q.hint}}">{{q.label}}</span>{{/each}}</p>
  {{/if}}
  {{#if canDefend}}
  <div class="defense-buttons">
    <button type="button" data-dtd-action="dodge"><i class="fa-solid fa-person-running" inert></i> {{localize "DTD.Combat.Dodge"}}</button>
    {{#if melee}}<button type="button" data-dtd-action="parry"><i class="fa-solid fa-shield-halved" inert></i> {{localize "DTD.Combat.Parry"}}</button>{{/if}}
  </div>
  {{/if}}
  {{#if canDamage}}
  <button type="button" class="attack-damage-button" data-dtd-action="rollDamage"><i class="fa-solid fa-burst" inert></i> {{localize "DTD.Attack.RollDamage"}}</button>
  {{/if}}
</div>
