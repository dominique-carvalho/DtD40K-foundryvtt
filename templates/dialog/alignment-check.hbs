<div class="alignment-check-dialog">
  <p class="hint">{{localize "DTD.Alignment.CheckHint"}}</p>
  <div class="form-group">
    <label>{{localize "DTD.Alignment.Bonus"}}</label>
    <div class="form-fields"><input type="number" name="bonus" value="0" step="1"></div>
  </div>
  <div class="form-group">
    <label>{{localize "DTD.Roll.Dialog.RollMode"}}</label>
    <div class="form-fields"><select name="rollMode">{{#each rollModes as |m|}}<option value="{{m.key}}" {{#if m.selected}}selected{{/if}}>{{localize m.label}}</option>{{/each}}</select></div>
  </div>
</div>
